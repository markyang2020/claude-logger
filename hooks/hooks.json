      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/claude_logger.py\" PostCompact",
            "timeout": 5
          }
        ]
      }
